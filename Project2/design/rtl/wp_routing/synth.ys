# 读取所有源文件
read_verilog -sv /workspace/design/rtl/wp_routing/wp_routing.v
read_verilog -sv /workspace/design/rtl/wp_routing/maze_fpga_top.sv
read_verilog -sv /workspace/design/rtl/wp_routing/maze_fpga_ctrl.sv
read_verilog -sv /workspace/design/rtl/wp_routing/maze_fpga_load.sv
read_verilog -sv /workspace/design/rtl/wp_routing/maze_fpga_bram.sv
read_verilog -sv /workspace/design/rtl/wp_routing/maze_fpga_array.sv
read_verilog -sv /workspace/design/rtl/wp_routing/maze_fpga_cell.sv
read_verilog -sv /workspace/design/rtl/wp_routing/maze_fpga_back.sv
read_verilog -sv /workspace/design/rtl/wp_routing/maze_fpga_decoder.sv

# 设置顶层并展开层次
hierarchy -check -top wp_routing

# 综合流程
proc
flatten
opt_expr
opt_clean
check
opt
wreduce
peepopt
opt_clean
share
techmap
opt -fast
abc -lut 4
opt_clean

# 输出 EDIF，使用与参考文件相同的单元名称映射
write_edif -pvector bra /workspace/design/rtl/wp_routing/wp_routing_syn.edf
